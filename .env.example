# Server Configuration
PORT=3000
SITE_OWNER="Your Name"

# SQLite Configuration
SQLITE_PATH="./data.sqlite"

# MongoDB Atlas Configuration (M0 Free Tier)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/support_assistant?retryWrites=true&w=majority"
MONGODB_DB="support_assistant"

# Optional Anthropic API (leave empty to use local FAQ/code search)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-haiku-20240307"

# Weather Configuration (Open-Meteo)
WEATHER_CITY="Chennai"
WEATHER_LAT=13.0827
WEATHER_LON=80.2707

# Testing / Debugging
ENABLE_TEST_ROUTES="true"
